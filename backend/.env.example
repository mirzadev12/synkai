# Backend orchestration env (also loads ../.env.local from the repo root)

PORT=3001

# Supabase (required for agents / memory / orchestration tables)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# LLM providers used by the orchestrator
ANTHROPIC_API_KEY=your_anthropic_key_here
GEMINI_API_KEY=your_gemini_key_here

# Optional: override Gemini model id if free-tier name differs
# GEMINI_MODEL=gemini-2.0-flash
