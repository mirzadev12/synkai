{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // No rootDir: nothing is emitted (noEmit), and scripts/ shares server/embed.ts
    // with the Vercel functions rather than duplicating it.
    "types": ["node"]
  },
  "include": ["src"]
}
