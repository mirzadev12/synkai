# Copy this file to .env.local and paste your Liveblocks public key.
# Get it from https://liveblocks.io → your project → API keys (starts with pk_)
VITE_LIVEBLOCKS_PUBLIC_KEY=pk_dev_paste_your_key_here

# Server-only keys (no VITE_ prefix). Used by POST /api/run and backend orchestration
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
# OpenRouter key — powers the canvas AI Block's "Claude" option (POST /api/run)
OPENROUTER_API_KEY=your_openrouter_key_here

# Backend orchestration (Express on :3001) — also set in backend/.env
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# GEMINI_MODEL=gemini-2.0-flash

